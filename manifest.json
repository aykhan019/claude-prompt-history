{
  "manifest_version": 3,
  "name": "Claude Prompt History",
  "version": "2.0.0",
  "description": "Sidebar panel on claude.ai showing your prompt history - click to scroll back.",
  "host_permissions": ["https://claude.ai/*"],
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["content.js"],
      "css": ["panel.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
